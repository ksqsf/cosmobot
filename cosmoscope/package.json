{
  "name": "cosmoscope",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run lint && npm run typecheck && vite build",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "npm run typecheck:ts7 && npm run typecheck:vue",
    "typecheck:ts7": "npm explore typescript-7 -- npm exec -- tsc --build ../.. --force",
    "typecheck:vue": "vue-tsc --build --force",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@mdit/plugin-katex": "^1.1.0",
    "@primeuix/themes": "^3.0.0",
    "@vueuse/core": "^14.4.0",
    "effect": "4.0.0-rc.112",
    "highlight.js": "^11.12.0",
    "katex": "^0.18.4",
    "markdown-it": "^15.0.1",
    "pinia": "^4.0.3",
    "primeicons": "^8.0.0",
    "primevue": "^5.0.1",
    "vue": "^3.5.42",
    "vue-router": "^5.3.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^26.4.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.9.1",
    "eslint-plugin-vue": "^10.10.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.0.1",
    "typescript": "npm:@typescript/typescript6@^6.0.0",
    "typescript-7": "npm:typescript@^7.0.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  },
  "allowScripts": {
    "msgpackr-extract@3.0.4": true
  }
}
